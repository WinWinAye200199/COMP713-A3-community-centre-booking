# Copy these values into your shell (export ...) before starting the backend and the consumer.
# Do not commit real passwords.

# MySQL (local server or the lecturer-provided server)
DB_URL=jdbc:mysql://localhost:3306/community_centre_booking?allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=change-me

# RabbitMQ (defaults match docker-compose.yml)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Consumer only: set to true to demonstrate retry and dead-lettering
SIMULATE_FAILURE=false
